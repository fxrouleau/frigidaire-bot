{
  "compilerOptions": {
    "target": "es2024",
    "module": "commonjs",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "exclude": ["vitest.config.ts", "src/**/*.test.ts", "src/test-support/**/*", "src/evals/**/*"]
}
