# Only what the image needs. Everything below is either regenerated in the image (deps, build
# output), local-only state, or tooling that has no business in a build context.

# Dependencies and build output — installed/compiled inside the image
node_modules/
dist/
*.tsbuildinfo

# Yarn state (node-modules linker: the cache is downloaded fresh inside the image)
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*

# Runtime data (SQLite DBs, error captures) and secrets
data/
.env
.env.*
memories.zip

# Git, editors, local tooling
.git
.github
# Except the one workflow whose owner-only guard src/github/claudeWorkflow.test.ts checks in the CI gate.
!.github/workflows/claude-feature-request.yml
.idea/
.vscode/
.claude
.editorconfig
.gitattributes
# .gitignore stays: Biome 2 (vcs.useIgnoreFile) refuses to run without it, and `yarn check:ci` runs in the image.
lefthook.yml
REFACTOR_PLAN.md

# Logs and OS junk
*.log
logs/
.DS_Store
