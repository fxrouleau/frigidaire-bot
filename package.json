{
  "name": "frigidaire-bot",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.4",
    "openai": "6.18.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26",
    "lefthook": "^1.13.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "prod": "node dist/app.js",
    "check": "biome check --fix src biome.json package.json tsconfig.json tsconfig.test.json nodemon.json vitest.config.ts",
    "check:ci": "biome check src biome.json package.json tsconfig.json tsconfig.test.json nodemon.json vitest.config.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run .live.test",
    "replay": "ts-node src/test-support/replayCli.ts",
    "eval:gate": "ts-node src/gate/eval/runEval.ts",
    "eval:persona": "ts-node src/evals/persona/cli.ts"
  }
}
